# Copy this file to `.env` for local development. Never commit real values.
SALVAGE_BIND=127.0.0.1:3000
SALVAGE_DATA_DIR=./data
SALVAGE_WEB_DIST=./dist
SALVAGE_PUBLIC_ORIGIN=http://127.0.0.1:3000
SALVAGE_COOKIE_SECURE=false
# Generate a distinct 32-byte key with: openssl rand -hex 32
SALVAGE_SESSION_KEY=replace-with-64-lowercase-hex-characters
# Production uses `grammers`; `fixture` is permitted only with the e2e-fixture feature.
SALVAGE_TELEGRAM_TRANSPORT=grammers
# Server-owned Telegram application credentials are required for live transport.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

[Unit]
Description=Salvage Cloud Caddy HTTPS proxy
Wants=network-online.target
After=network-online.target salvage-cloud.service
Requires=salvage-cloud.service

[Service]
Type=simple
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/caddy/config
EnvironmentFile=/etc/salvage-cloud/caddy.env
ExecStart=/usr/local/bin/caddy run --environ --config /etc/salvage-cloud/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/salvage-cloud/Caddyfile
WorkingDirectory=/var/lib/caddy
UMask=0077
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

[Unit]
Description=Salvage Cloud application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=salvage
Group=salvage
EnvironmentFile=/etc/salvage-cloud/environment
WorkingDirectory=/opt/salvage-cloud
ExecStart=/opt/salvage-cloud/salvage-server
UMask=0077
Restart=on-failure
RestartSec=3s
TimeoutStopSec=45s
KillSignal=SIGTERM
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/salvage-cloud
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
